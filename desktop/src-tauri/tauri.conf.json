{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrowWise",
  "version": "0.1.0-alpha.0",
  "identifier": "dev.growwise.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GrowWise",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries"],
    "shortDescription": "Parent-led, local-first Personal Education OS",
    "longDescription": "GrowWise organizes learning records, resources, growth context and parent-reviewed learning materials."
  }
}
